# ── Compose substitution vars (PUBLIC — no secrets belong in this file) ──

# Pin the image by DIGEST for immutability (not a moving tag). Get the digest:
#   docker buildx imagetools inspect vinanrra/7dtd-server:latest
# then paste the sha256 below. The audit workflow FAILS if this isn't a digest.
SDTD_IMAGE=vinanrra/7dtd-server@sha256:15fb8c1948ef669f66a5a9db81610afb52aabbf1df5954e6bbe12774644f1d8c

# Host paths & runtime identity. DATA_DIR holds gitignored runtime state.
DATA_DIR=./data
PUID=1000
PGID=1000
TZ=UTC

# Ports. Only the game port is exposed (plus 26901-26902/udp in the compose).
GAME_PORT=26900
