# ── Enshrouded server config (PUBLIC — this is your config-as-code) ──
# Changing a setting = a public, signed commit. The audit workflow ENFORCES the
# admin locks below on every push, so no commit can quietly re-enable admin.
#
# The image turns SERVER_* variables into the server's enshrouded_server.json on
# every container start. The server then fills in everything not set here with
# its own defaults. The full result - every setting the server actually runs
# with, password blanked - is published in config/approved-config.json, and the
# watcher alerts if the live file stops matching it.

# ═══════════════ ADMIN LOCKS — do not change ═══════════════
# Enshrouded has no console, no RCON and no admin list. Its whole admin surface
# is its USER GROUPS: each group has a password and a set of permissions, and a
# player gets the permissions of whichever group's password they type when they
# join. The one admin power is canKickBan.
#
# So there is exactly ONE group, everyone joins with the same password, and that
# group cannot kick or ban. With no second group there is no second password that
# could carry more rights than everyone else's. The audit fails any commit that
# defines SERVER_ROLE_1_* or above, or gives any group kick/ban.
SERVER_ROLE_0_NAME=Default
SERVER_ROLE_0_CAN_KICK_BAN=false
# The group's password is the JOIN password. It is PRIVATE: the real value lives
# in game.local.env on the host (gitignored), never in this public file.
SERVER_ROLE_0_PASSWORD=
# The image's old single-password setting from before user groups. When set it
# overwrites the Default group's password, so it stays empty: there is one
# password, and it is set in exactly one place.
SERVER_PASSWORD=
# The image can also run shell commands from *_HOOK variables (BOOTSTRAP_HOOK,
# UPDATE_PRE_HOOK, ...). None are used here: a hook runs as the server inside
# the container, and the audit fails if one is set. The watcher alerts if one
# ever runs.
# ═══════════════════════════════════════════════════════════

# Identity
#
# Matches the RageQuit-<Game> convention: RageQuit-Palworld,
# RageQuit-7DaysToDie, RageQuit-Valheim, RageQuit-Enshrouded.
SERVER_NAME=RageQuit-Enshrouded
# 16 is both the game's default and its maximum.
SERVER_SLOT_COUNT=16

# What every player can do.
#
# A fresh Enshrouded 1.0 server generates FOUR groups, each with a random
# password: Admin (everything), Friend (everything except kick/ban and extend
# base), Guest and Visitor (less). That layout assumes one trusted host holding
# the Admin password - exactly what this repo exists to rule out.
#
# So the single group here gets the Admin group's permissions MINUS kick/ban,
# which is Friend plus canExtendBase. Extend base is what places and grows Flame
# Altars - a base's footprint - so without an Admin, a server of Friends could
# never start a base at all. Everyone has every remaining permission, so nobody
# has more than anyone else.
SERVER_ROLE_0_CAN_ACCESS_INVENTORIES=true
SERVER_ROLE_0_CAN_EDIT_WORLD=true
SERVER_ROLE_0_CAN_EDIT_BASE=true
SERVER_ROLE_0_CAN_EXTEND_BASE=true
SERVER_ROLE_0_RESERVED_SLOTS=0

# ─────────────── Gameplay: vanilla ───────────────
# Charl, 2026-10-16: vanilla server settings. Nothing gameplay-related is set
# here, so the server runs its own defaults: gameSettingsPreset "Default".
#
# Deliberately NOT set as SERVER_GS_PRESET=Default, even though that is the same
# value: with any SERVER_GS_* variable present, this image (1.7.2) rewrites the
# config through a temp file and leaves it readable by its owner only, which
# the watcher - running as its own user - would see as the config vanishing for
# ~15 seconds on every start. The preset is still pinned: it is in
# config/approved-config.json, and the live file is checked against that.

# Keep the server binary matched to whatever Steam ships. Enshrouded CLIENTS
# update themselves through Steam, and a client newer than the server cannot
# join - so a server that does not update locks everyone out within hours of a
# patch. Same reasoning as 7DTD and Valheim. Every 15 minutes the image asks
# Steam for the current build and installs it only when NOBODY is online (it
# counts players over the public query port). The container IMAGE stays
# digest-pinned in stack.env regardless — this only updates the game files from
# Steam's own depot.
UPDATE_CRON=*/15 * * * *
UPDATE_CHECK_PLAYERS=true
