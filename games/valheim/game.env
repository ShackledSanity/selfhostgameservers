# ── Valheim server config (PUBLIC — this is your config-as-code) ──
# Changing a setting = a public, signed commit. The audit workflow ENFORCES the
# admin locks below on every push, so no commit can quietly re-enable admin.

# ═══════════════ ADMIN LOCKS — do not change ═══════════════
# Valheim's entire cheat surface is the ADMIN LIST. A player whose SteamID64 is
# in adminlist.txt can open the F5 console, type `devcommands`, and then spawn
# items, fly, kill everything, change world modifiers live — the lot. Nobody
# else can, and there is no password that grants it. So: the list stays EMPTY.
#
# ADMINLIST_IDS is authoritative in this image — it OVERWRITES the live
# adminlist.txt on every container start, so a hand-edit on the host is undone
# within one restart and the watcher alerts on it in the meantime.
ADMINLIST_IDS=
# The management interfaces this image can optionally expose. All off.
SUPERVISOR_HTTP=false
STATUS_HTTP=false
# Mod loaders. A mod can reintroduce cheats without touching any of the above,
# so both stay off and the watcher greps the logs for either of them starting.
VALHEIM_PLUS=false
BEPINEX=false
# ═══════════════════════════════════════════════════════════

# Identity
#
# Matches the RageQuit-<Game> convention: RageQuit-Palworld,
# RageQuit-7DaysToDie, RageQuit-Valheim.
#
# Valheim keeps its OWN join password, set in game.local.env. Do not replace it
# with another server's: Valheim refuses to start if the join password appears
# as a substring of the server name, the world name or the seed name, so the
# name and the password here are chosen against each other. Whether a given
# pair is legal cannot be worked out from this public file — preflight.sh
# checks the real value before a deploy.
#
# When it trips, the server simply never comes up and the error is buried in
# the container log rather than shown anywhere obvious.
SERVER_NAME=RageQuit-Valheim
SERVER_PUBLIC=true

# The world the server loads, by file name, from /config/worlds_local.
#
# Charl's call, 2026-09-29: let the server generate its own world with a RANDOM
# seed on first boot. (Valheim has no -seed argument for dedicated servers, so a
# chosen seed would have meant generating the world in the client and copying
# the .fwl/.db across by hand. Not worth it.)
#
# Once that world exists it is the only irreplaceable thing on this box, and it
# lives in gitignored runtime state — not in this repo. Deleting
# data/config/worlds_local does not "re-roll the seed", it destroys the save.
#
# This name is constrained by the same password-substring rule described under
# SERVER_NAME above, so it is not free to change on its own. Players never see
# it — it is only the save file name.
WORLD_NAME=Yggdrasil

# JOIN password — gates who can connect. NOT an admin credential (grants zero
# privileges, irrelevant to fairness). Kept PRIVATE: the real value lives in
# game.local.env on the host (gitignored), never in this public file.
# Valheim requires at least 5 characters and rejects a password contained in
# the server or world name — see the SERVER_NAME note above. This server's
# password is its own; it is not the one the other games use.
SERVER_PASS=

# Steam clients only. Set true to let Xbox/Game Pass players in; that also
# opens 2458/udp, which then needs adding to `ports` in manifest.json.
CROSSPLAY=false

# Keep the server binary matched to whatever Steam ships, because Valheim
# CLIENTS auto-update and a version mismatch locks every player out. Same
# reasoning as 7DTD. UPDATE_IF_IDLE means it waits for an empty server rather
# than dropping people mid-raid. The container IMAGE stays digest-pinned in
# stack.env regardless — this only updates the game files from Steam's depot.
UPDATE_CRON=*/15 * * * *
UPDATE_IF_IDLE=true
RESTART_IF_IDLE=true

# World backups (inside the container's /config/backups).
BACKUPS=true
BACKUPS_INTERVAL=7200
BACKUPS_MAX_AGE=3
BACKUPS_IF_IDLE=false

# ─────────────── Gameplay: world modifiers (change via pull request) ───────────────
# Valheim applies value modifiers (-modifier) to an EXISTING world on the next
# start. Toggle keys (-setkey) are only read at world creation, which is why
# none are set here — every toggle we want is the default anyway.
#
# Requested settings, and how each maps:
#
#   Combat / enemy damage / health / spawn / bosses / stars  -> normal  (default)
#   Death penalty: casual, minimal skill loss                -> deathpenalty casual
#   Resources 1.5x                                           -> resources more
#   Raids: frequency + difficulty normal                     -> normal  (default)
#   Portals: no restrictions, all items                      -> portals casual
#   Building / crafting / food / stamina / skill gain normal -> normal  (default)
#   Map enabled + sharing                                    -> default (no `nomap`)
#
# `normal` values are left OFF the command line on purpose: they are the
# defaults, and passing a value the binary does not recognise makes the server
# refuse to start. Adding them would be noise that can only break things.
#
#   deathpenalty casual = keep equipped gear, drop the rest, 1% skill loss
#                         (the gentlest option Valheim has short of no death)
#   resources more      = 1.5x drops, exactly as requested
#   portals casual      = everything passes through portals, including ores
SERVER_ARGS=-modifier deathpenalty casual -modifier resources more -modifier portals casual
