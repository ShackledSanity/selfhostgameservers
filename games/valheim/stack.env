# ── Compose substitution vars (PUBLIC — no secrets belong in this file) ──

# Pin the image by DIGEST for immutability (not a moving tag). Get the digest:
#   docker buildx imagetools inspect lloesche/valheim-server:latest
# then paste the sha256 below. The audit workflow FAILS if this isn't a digest.
# This one was taken from Docker Hub on 2026-09-29 (tag `latest`, pushed
# 2026-09-19). If `docker pull` rejects it, the digest moved — re-inspect and
# update this line in a commit rather than falling back to a tag.
VALHEIM_IMAGE=lloesche/valheim-server@sha256:c885aa902faf885ceb8f69a34663b90519e65aa65fbd9f893451f0640e218a4f

# Host paths & runtime identity. DATA_DIR holds gitignored runtime state:
#   data/config   -> /config      worlds, adminlist.txt, backups
#   data/server   -> /opt/valheim the ~2GB game install, kept so a config
#                                 change does not re-download it
DATA_DIR=./data
PUID=1000
PGID=1000
TZ=UTC

# Ports. 2456 is the game port, 2457 the Steam query port.
# Crossplay (off) would additionally need 2458/udp.
GAME_PORT=2456
QUERY_PORT=2457
